#!/bin/sh
# 1) Fenetre protegee (corp-ai/hooks/fenetre-protegee.sh).
# 2) Confidentialite AVANT que le contenu devienne public sur GitHub : la CI refait le meme
#    controle, mais apres le push. Denylist : ~/corp-ai/.privacy-denylist.
# Bypass fondateur : git push --no-verify
FENETRE="${ALFRED_HOOKS:-$HOME/corp-ai/hooks}/fenetre-protegee.sh"
if [ ! -f "$FENETRE" ]; then
  echo "Push refuse : $FENETRE introuvable. Cloner corp-ai dans ~/corp-ai ou regler ALFRED_HOOKS."
  exit 1
fi
if bash "$FENETRE"; then
  echo "Push refuse - fenetre protegee. Bypass fondateur : git push --no-verify"
  exit 1
fi
node scripts/privacy-scan.mjs || { echo "Push refuse (confidentialite)."; exit 1; }
