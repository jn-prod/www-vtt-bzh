#!/bin/sh
# Fenetre protegee §22 : source unique dans corp-ai (hooks/fenetre-protegee.sh).
# corp-ai introuvable => commit refuse (fail-closed). Bypass fondateur : git commit --no-verify
FENETRE="${ALFRED_HOOKS:-$HOME/corp-ai/hooks}/fenetre-protegee.sh"
if [ ! -f "$FENETRE" ]; then
  echo "Commit refuse : $FENETRE introuvable. Cloner corp-ai dans ~/corp-ai ou regler ALFRED_HOOKS."
  exit 1
fi
if bash "$FENETRE"; then
  echo ""
  echo "Commit bloque - fenetre protegee (§22)"
  echo "Bypass fondateur (avec mention du risque) : git commit --no-verify"
  echo ""
  exit 1
fi
exit 0
