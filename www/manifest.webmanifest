---
layout: null
permalink: /manifest.webmanifest
---
{
  "name": "{{ site.title }}",
  "short_name": "{{ site.title }}",
  "description": "{{ site.description }}",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#ffffff",
  "theme_color": "#1C7D44",
  "lang": "fr-FR",
  "icons": [
    {
      "src": "{{ site.url }}/assets/images/logo-mark.svg",
      "type": "image/svg+xml",
      "sizes": "any",
      "purpose": "any"
    }
  ]
}
